---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-4">
      {tags.map((tag: string) => (
        <span class="text-yellow rounded text-sm px-4 py-3 bg-navy-300">
          {tag}
        </span>
      ))}
    </div>
  )
}
