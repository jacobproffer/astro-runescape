---
interface Props {
  headline: string;
  id?: string;
}

const { headline, id } = Astro.props;
---

<section class="relative overflow-hidden">
  <div
    class="pt-6 pb-4 px-6 mx-1 bg-navy-100 outline outline-gray -outline-offset-1 rounded-t-md"
  >
    {
      headline && (
        <h1
          class="text-4xl max-md:text-3xl font-cinzel font-bold uppercase text-yellow text-balance text-shadow-sm text-shadow-black"
          id={id}
        >
          {headline}
        </h1>
      )
    }
  </div>
  <slot />
  <div class="w-full h-4 bg-navy-200 shadow-vertical-hard"></div>
</section>
