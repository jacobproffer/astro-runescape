---
interface Props {
  headline: string;
}

const { headline } = Astro.props;
---

<section class="relative bg-navy-200 overflow-hidden">
  <div
    class="relative z-10 w-full h-4 border-b border-solid border-gray shadow-vertical-hard"
  >
  </div>
  <div
    class="pt-6 pb-4 px-6 bg-navy-100 outline outline-gray -outline-offset-1"
  >
    {
      headline && (
        <h1 class="text-4xl max-md:text-2xl font-cinzel font-bold uppercase text-yellow text-balance">
          {headline}
        </h1>
      )
    }
  </div>
  <slot />
  <div class="w-full h-4 shadow-vertical-hard"></div>
</section>
