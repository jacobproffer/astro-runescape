---
import ContentBox from "@components/ContentBox.astro";

interface Props {
  headline: string;
  id?: string;
}

const { headline, id } = Astro.props;
---

<section class="relative overflow-hidden">
  <ContentBox background="navy-100" class="py-4 px-4 mx-2">
    {
      headline && (
        <h1
          class="text-4xl max-md:text-3xl font-cinzel font-bold uppercase text-yellow text-balance text-shadow-sm text-shadow-black"
          id={id}
        >
          {headline}
        </h1>
      )
    }
  </ContentBox>
  <slot />
  <div class="w-full h-4 bg-navy-200 shadow-vertical-hard"></div>
</section>
