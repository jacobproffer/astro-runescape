---
interface Props {
  title: string;
  description: string;
  isLast?: boolean;
}

const { title, description, isLast = false } = Astro.props;
---

<li class={`relative pl-6 ${isLast ? "pb-0" : "pb-8"}`}>
  <div class="absolute w-3 h-3 bg-yellow rounded-full -left-1 top-2.5"></div>
  <div class="text-yellow font-bold text-lg mb-1">
    {title}
  </div>
  <p class="text-gray-300 leading-7">
    {description}
  </p>
</li>
