---
import { Image } from "astro:assets";
import border from "@assets/img/border.jpg";
import Container from "@components/Container.astro";
---

<footer class="relative z-20 mt-1 bg-tan">
  <Image
    class="block w-full"
    src={border}
    alt=""
    sizes="100vw"
    quality={75}
    widths={[576, 768, 1024, 1280, 1536]}
    loading="lazy"
    format="webp"
    decoding="async"
  />
  <Container topSpacing={false}>
    <p class="py-4 text-sm text-navy-300">
      This site is built by Jacob Proffer using Astro, Tailwind CSS, TypeScript,
      and the RuneMetrics API.
    </p>
  </Container>
</footer>
