---
/**
 * SkillsTable Component
 *
 * Renders a sortable table displaying all of a player's RuneScape skills with their
 * levels, experience points, and rankings. Skills are automatically sorted by XP in
 * descending order. The table features alternating row colors for better readability.
 *
 * @component
 * @example
 * ```astro
 * <SkillsTable skills={profile.skillvalues} />
 * ```
 *
 * @prop {RuneMetricsProfile["skillvalues"]} skills - Array of skill objects containing:
 *   - id: Numeric identifier for the skill
 *   - level: Current skill level (1-99 or 1-120 for elite skills)
 *   - xp: Experience points in the skill (stored as value * 10)
 *   - rank: Player's ranking for this specific skill
 *
 * @note Skills are displayed in descending order by XP. XP values are divided by 10
 *   for display as the API returns them multiplied by 10.
 */
import type { RuneMetricsProfile } from "@/types/runescape";
import { SKILL_NAMES } from "@/types/runescape";
import Divider from "@components/Divider.astro";

interface Props {
  skills: RuneMetricsProfile["skillvalues"];
}

const { skills } = Astro.props;
---

<section>
  <div class="p-4 bg-purple-100 outline outline-gray -outline-offset-1">
    <h2 class="text-3xl text-yellow font-cinzel uppercase font-bold">Skills</h2>
  </div>
  {
    skills.length > 0 ? (
      <div class="overflow-x-auto">
        <table class="w-full border-separate border-spacing-y-0.75">
          <thead>
            <tr class="bg-purple-200 outline outline-gray -outline-offset-1">
              <th class="text-yellow text-left py-3 px-4">Skill</th>
              <th class="text-yellow text-right py-3 px-4">Level</th>
              <th class="text-yellow text-right py-3 px-4">XP</th>
              <th class="text-yellow text-right py-3 px-4">Rank</th>
            </tr>
          </thead>
          <tbody>
            {[...skills]
              .sort((a, b) => (b?.xp || 0) / 10 - (a?.xp || 0) / 10)
              .map((skill, index) => (
                <tr
                  class={`text-gray-300 outline outline-gray -outline-offset-1 shadow-vertical-soft ${index % 2 === 0 ? "bg-purple-100" : "bg-purple-200"}`}
                >
                  <td class="py-3 px-4 text-yellow font-medium">
                    {SKILL_NAMES[skill?.id] ||
                      `Skill ${skill?.id || "Unknown"}`}
                  </td>
                  <td class="text-right py-3 px-4">{skill?.level || 0}</td>
                  <td class="text-right py-3 px-4">
                    {Math.floor((skill?.xp || 0) / 10).toLocaleString()}
                  </td>
                  <td class="text-right py-3 px-4">
                    {(skill?.rank || 0).toLocaleString()}
                  </td>
                </tr>
              ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="text-gray-500 text-center py-4">No skill data available</p>
    )
  }
  <Divider loading="lazy" />
</section>
