---
import type { CollectionEntry } from "astro:content";
import SecondaryHeadline from "@components/SecondaryHeadline.astro";
import TagList from "@components/TagList.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<article
  class="bg-navy-200 border border-gray-dark hover:border-yellow transition-colors"
>
  <a href={`/blog/${post.slug}`} class="flex flex-col gap-0.75 bg-black group">
    <SecondaryHeadline text={post.data.title} />
    <div
      class="flex flex-col gap-4 p-4 border-t border-solid border-gray bg-navy-200"
    >
      <time
        datetime={post.data.pubDate.toISOString()}
        class="text-lg text-yellow text-shadow-black block"
      >
        {
          post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "America/New_York",
          })
        }
      </time>
      <p class="text-gray-300">{post.data.description}</p>
      <TagList tags={post.data.tags} variant="small" />
    </div>
  </a>
</article>
