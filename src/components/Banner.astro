---
import { Image } from "astro:assets";
import banner from "@assets/img/banner.jpg";
---

<div
  class="absolute inset-0 -z-1 w-full h-90 border-b border-solid border-gray-dark"
>
  <Image
    class="block w-full h-full object-cover object-center-right"
    src={banner}
    alt=""
    loading="eager"
    widths={[400, 768, 1024, 1280, 1536]}
    sizes="100vw"
    quality={80}
    format="webp"
  />
</div>
