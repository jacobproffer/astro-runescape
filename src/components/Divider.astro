---
import { Image } from "astro:assets";
import divider from "@assets/img/divider.jpg";

interface Props {
  loading?: "eager" | "lazy";
}

const { loading = "lazy" } = Astro.props;
---

<Image
  class="block w-full"
  src={divider}
  alt=""
  sizes="100vw"
  width={1000}
  height={32}
  widths={[421, 562, 750, 1000]}
  quality={75}
  format="webp"
  loading={loading}
  decoding="async"
/>
