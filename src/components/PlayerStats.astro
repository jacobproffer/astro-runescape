---
/**
 * PlayerStats Component
 *
 * Displays a player's key statistics in a visually organized grid layout.
 * This component shows combat level, total skill level, total XP, quests completed,
 * overall rank, and current online status.
 *
 * @component
 * @example
 * ```astro
 * <PlayerStats profile={playerProfile} />
 * ```
 *
 * @prop {RuneMetricsProfile} profile - The player's RuneMetrics profile data containing
 *   - combatlevel: The player's combat level
 *   - totalskill: Sum of all skill levels
 *   - totalxp: Total experience points across all skills
 *   - questscomplete: Number of completed quests
 *   - rank: Overall player ranking
 *   - loggedIn: String "true" or "false" indicating online status
 */
import type { RuneMetricsProfile } from "@/types/runescape";
import Divider from "@components/Divider.astro";

interface Props {
  profile: RuneMetricsProfile;
}

const { profile } = Astro.props;
---

<section>
  <h2 class="text-3xl font-cinzel font-bold uppercase mb-6 text-yellow">
    Player Stats
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="text-center p-4 bg-gray-50 rounded">
      <div class="text-4xl font-bold">
        {profile.combatlevel ?? 0}
      </div>
      <div class="text-gray-600 mt-2">Combat Level</div>
    </div>
    <div class="text-center p-4 bg-gray-50 rounded">
      <div class="text-4xl font-bold">
        {profile.totalskill ?? 0}
      </div>
      <div class="text-gray-600 mt-2">Total Skill Level</div>
    </div>
    <div class="text-center p-4 bg-gray-50 rounded">
      <div class="text-4xl font-bold">
        {(profile.totalxp ?? 0).toLocaleString()}
      </div>
      <div class="text-gray-600 mt-2">Total XP</div>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="text-center p-3 bg-gray-50 rounded">
      <div class="text-2xl font-bold">
        {profile.questscomplete ?? 0}
      </div>
      <div class="text-gray-600 text-sm">Quests Complete</div>
    </div>
    <div class="text-center p-3 bg-gray-50 rounded">
      <div class="text-2xl font-bold">{profile.rank ?? "N/A"}</div>
      <div class="text-gray-600 text-sm">Overall Rank</div>
    </div>
    <div class="text-center p-3 bg-gray-50 rounded">
      <div class="text-2xl font-bold">
        {profile.loggedIn === "true" ? "Online" : "Offline"}
      </div>
      <div class="text-gray-600 text-sm">Status</div>
    </div>
  </div>
  <Divider loading="eager" />
</section>
