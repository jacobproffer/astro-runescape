---
import { SEO, type Props as SEOProps } from "astro-seo";
const facebookImageFile = new URL("/images/facebook-social.jpg", Astro.url);
const twitterImageFile = new URL("/images/twitter-social.jpg", Astro.url);

interface Props {
  seo?: SEOProps;
}

const { seo } = Astro.props;

const siteName = "Apone - An Adventurer in RuneScape";
const siteDescription =
  "Created in October of 2003, Apone is a character in the game RuneScape.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<SEO
  title={seo?.title}
  description={seo?.description ?? siteDescription}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      url: canonicalURL,
      title: seo?.title ?? "Apone",
      type: "website",
      image: facebookImageFile.toString(),
    },
    image: {
      url: facebookImageFile.toString(),
      secureUrl: facebookImageFile.toString(),
      alt: "",
      height: 1200,
      width: 800,
    },
  }}
  extend={{
    meta: [
      {
        name: "og:locale",
        content: "en_US",
      },
      {
        name: "og:description",
        content: seo?.description ?? siteDescription,
      },
      {
        name: "og:site_name",
        content: siteName,
      },
      {
        name: "twitter:card",
        content: "summary_large_image",
      },
      {
        name: "twitter:title",
        content: seo?.title ?? "Apone",
      },
      {
        name: "twitter:description",
        content: seo?.description ?? siteDescription,
      },
      {
        name: "twitter:image",
        content: twitterImageFile.toString(),
      },
      {
        name: "twitter:image:alt",
        content: "Apone, a character in RuneScape, holding a Noxious Staff.",
      },
    ],
  }}
/>
