---
interface Props {
  message?: string;
}

const { message = "Loading player data..." } = Astro.props;
---

<div class="flex flex-col items-center justify-center min-h-100 p-8">
  <div class="relative w-20 h-20">
    <div
      class="w-full h-full border-4 border-yellow-400/20 border-t-yellow-400 rounded-full animate-spin"
    >
    </div>
  </div>
  <p class="mt-6 text-lg text-yellow font-medium text-center animate-pulse">
    {message}
  </p>
</div>
