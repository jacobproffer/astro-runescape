---
import avatar from "@assets/img/avatar.png";
import Avatar from "@components/Avatar.astro";
import NavLink from "@components/NavLink.astro";

const { characterName } = Astro.props;
---

<div class="bg-navy-200 border-t border-b border-solid border-gray-dark">
  <div
    class="relative flex items-center justify-between container px-6 mx-auto"
  >
    <header class="my-2">
      <NavLink
        class="fixed -top-full left-1/2 -translate-x-1/2 transition-top ease-in-out delay-150 focus:top-4"
        heightFull={false}
        href="#content">Skip to main content</NavLink
      >
      <Avatar image={avatar} characterName={characterName} />
    </header>
    <nav
      class="absolute top-1/2 right-6 h-full -translate-y-1/2"
      aria-label="primary"
    >
      <ul
        class="flex items-center max-w-max h-full border-r border-r-gray-dark"
      >
        <li class="h-full">
          <NavLink href="/blog" heightFull={true}>Blog</NavLink>
        </li>
      </ul>
    </nav>
  </div>
</div>
