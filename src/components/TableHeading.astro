---
interface Props {
  text: string;
  position: "left" | "right";
}

const { text, position } = Astro.props;
const alignmentClass = position === "left" ? "text-left" : "text-right";
---

<th
  class={`text-yellow text-lg text-shadow-sm text-shadow-black ${alignmentClass} py-3 px-4`}
  >{text}</th
>
