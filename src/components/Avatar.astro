---
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  characterName?: string;
  loading?: "eager" | "lazy";
}

const { image, characterName } = Astro.props;
---

<a
  class="group flex items-center gap-4 focus:outline focus:outline-dashed focus:outline-yellow focus:outline-offset-4"
  href="/"
  aria-label="Go to home page"
>
  <div
    class="relative shrink-0 size-14 md:size-16 rounded-full p-0.5 bg-linear-to-b from-yellow to-gold-dark shadow-[0_0_0_1px_var(--color-black),0_2px_6px_rgb(0_0_0/0.8)]"
  >
    <Image
      class="block w-full h-full object-cover object-bottom-right rounded-full bg-black border border-black"
      src={image}
      alt=""
      loading={Astro.props.loading || "eager"}
      width={128}
      height={128}
      widths={[64, 128, 256]}
      sizes="64px"
      quality={80}
      format="webp"
    />
    <span
      class="absolute -right-1.5 -bottom-1 hidden min-w-7 py-0.5 px-1 rounded-sm bg-black border border-yellow text-center text-xs font-bold leading-none text-yellow text-shadow-sm text-shadow-black"
      id="nav-combat-level"
      aria-hidden="true"></span>
  </div>
  <span class="flex flex-col gap-0.5">
    <span
      class="font-cinzel font-bold text-lg md:text-xl leading-tight text-yellow text-shadow-sm text-shadow-black group-hover:text-cream transition-colors"
      >{characterName || "Apone"}</span
    >
    <span class="text-xs md:text-sm text-tan" id="nav-subtitle"
      >Adventurer of Gielinor</span
    >
  </span>
</a>
