---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import type { RuneMetricsProfile } from "@/types/runescape";
import { SKILL_NAMES } from "@/types/runescape";

const CHARACTER_NAME = import.meta.env.CHARACTER_NAME || "Apone";

// Fetch RuneMetrics profile data
let profile: RuneMetricsProfile | null = null;
let error: string | null = null;

try {
  const response = await fetch(
    `https://apps.runescape.com/runemetrics/profile/profile?user=${encodeURIComponent(CHARACTER_NAME)}&activities=20`
  );

  if (!response.ok) {
    throw new Error(`Failed to fetch profile: ${response.statusText}`);
  }

  profile = await response.json();
} catch (e) {
  error = e instanceof Error ? e.message : "Unknown error occurred";
  console.error("Error fetching RuneMetrics data:", e);
}

const pageTitle = profile?.name || CHARACTER_NAME;
---

<BaseLayout pageTitle={pageTitle}>
  <Hero headline={pageTitle} />

  {
    error && (
      <section class="py-12">
        <div class="container mx-auto px-4">
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <strong class="font-bold">Error:</strong>
            <span class="block sm:inline"> {error}</span>
          </div>
        </div>
      </section>
    )
  }

  {
    profile && (
      <section class="py-12">
        <div class="container mx-auto px-4">
          {/* Player Stats Overview */}
          <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
            <h2 class="text-3xl font-bold mb-6">Player Stats</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="text-center p-4 bg-gray-50 rounded">
                <div class="text-4xl font-bold text-blue-600">
                  {profile.combatlevel}
                </div>
                <div class="text-gray-600 mt-2">Combat Level</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded">
                <div class="text-4xl font-bold text-green-600">
                  {profile.totalskill}
                </div>
                <div class="text-gray-600 mt-2">Total Skill Level</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded">
                <div class="text-4xl font-bold text-purple-600">
                  {profile.totalxp.toLocaleString()}
                </div>
                <div class="text-gray-600 mt-2">Total XP</div>
              </div>
            </div>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="text-center p-3 bg-gray-50 rounded">
                <div class="text-2xl font-bold">{profile.questscomplete}</div>
                <div class="text-gray-600 text-sm">Quests Complete</div>
              </div>
              <div class="text-center p-3 bg-gray-50 rounded">
                <div class="text-2xl font-bold">{profile.rank}</div>
                <div class="text-gray-600 text-sm">Overall Rank</div>
              </div>
              <div class="text-center p-3 bg-gray-50 rounded">
                <div class="text-2xl font-bold">
                  {profile.loggedIn === "true" ? "Online" : "Offline"}
                </div>
                <div class="text-gray-600 text-sm">Status</div>
              </div>
            </div>
          </div>

          {/* Skills Table */}
          <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
            <h2 class="text-3xl font-bold mb-6">Skills</h2>
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="border-b-2 border-gray-200">
                    <th class="text-left py-3 px-4">Skill</th>
                    <th class="text-right py-3 px-4">Level</th>
                    <th class="text-right py-3 px-4">XP</th>
                    <th class="text-right py-3 px-4">Rank</th>
                  </tr>
                </thead>
                <tbody>
                  {profile.skillvalues
                    .sort((a, b) => b.xp - a.xp)
                    .map((skill) => (
                      <tr class="border-b border-gray-100 hover:bg-gray-50">
                        <td class="py-3 px-4 font-medium">
                          {SKILL_NAMES[skill.id] || `Skill ${skill.id}`}
                        </td>
                        <td class="text-right py-3 px-4">{skill.level}</td>
                        <td class="text-right py-3 px-4">
                          {skill.xp.toLocaleString()}
                        </td>
                        <td class="text-right py-3 px-4">
                          {skill.rank.toLocaleString()}
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </div>

          {/* Recent Activities */}
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h2 class="text-3xl font-bold mb-6">Recent Activities</h2>
            <div class="space-y-4">
              {profile.activities.map((activity) => (
                <div class="border-l-4 border-blue-500 pl-4 py-2">
                  <div class="font-semibold text-lg">{activity.text}</div>
                  <div class="text-gray-600 text-sm">{activity.details}</div>
                  <div class="text-gray-400 text-xs mt-1">{activity.date}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
