---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import type { RuneMetricsProfile } from "@/types/runescape";
import { SKILL_NAMES } from "@/types/runescape";

const CHARACTER_NAME = import.meta.env.PUBLIC_CHARACTER_NAME || "Apone";

// Fetch RuneMetrics profile data
let profile: RuneMetricsProfile | null = null;
let error: string | null = null;

try {
  // Set up timeout for the fetch request
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 8000); // 8 second timeout

  const response = await fetch(
    `https://apps.runescape.com/runemetrics/profile/profile?user=${encodeURIComponent(CHARACTER_NAME)}&activities=20`,
    { signal: controller.signal }
  );

  clearTimeout(timeoutId);

  if (!response.ok) {
    throw new Error(`Failed to fetch profile: ${response.statusText}`);
  }

  const data = await response.json();

  // Validate response structure
  if (!data || typeof data !== "object") {
    throw new Error("Invalid API response structure");
  }

  // Ensure arrays exist and are valid
  profile = {
    ...data,
    activities: Array.isArray(data.activities) ? data.activities : [],
    skillvalues: Array.isArray(data.skillvalues) ? data.skillvalues : [],
  } as RuneMetricsProfile;
} catch (e) {
  if (e instanceof Error && e.name === "AbortError") {
    error = "Request timed out. The RuneScape API is not responding.";
  } else {
    error = e instanceof Error ? e.message : "Unknown error occurred";
  }
  console.error("Error fetching RuneMetrics data:", e);
}

const pageTitle = profile?.name || CHARACTER_NAME;
const skills = profile?.skillvalues || [];
const activities = profile?.activities || [];

// Helper function to format XP values in activity text
const formatActivityText = (text: string | undefined): string => {
  if (!text) return "";
  // Match patterns like "92000000XP" and format with commas
  // Also format standalone numbers with 4+ digits
  return text.replace(/(\d{4,})/g, (match) => {
    return parseInt(match, 10).toLocaleString();
  });
};

// Helper function to convert date strings to ISO 8601 format for datetime attributes
const toISODateTime = (dateString: string | undefined): string | null => {
  if (!dateString) return null;
  try {
    const date = new Date(dateString);
    // Check if the date is valid
    if (isNaN(date.getTime())) return null;
    return date.toISOString();
  } catch {
    return null;
  }
};
---

<BaseLayout pageTitle={pageTitle}>
  <Hero headline={pageTitle} />

  {
    error && (
      <section class="py-12">
        <div class="container mx-auto px-4">
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <strong class="font-bold">Error:</strong>
            <span class="block sm:inline"> {error}</span>
          </div>
        </div>
      </section>
    )
  }

  {
    profile && (
      <section class="py-12">
        <div class="container mx-auto px-4">
          {/* Player Stats Overview */}
          <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
            <h2 class="text-3xl font-bold mb-6">Player Stats</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="text-center p-4 bg-gray-50 rounded">
                <div class="text-4xl font-bold text-blue-600">
                  {profile.combatlevel ?? 0}
                </div>
                <div class="text-gray-600 mt-2">Combat Level</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded">
                <div class="text-4xl font-bold text-green-600">
                  {profile.totalskill ?? 0}
                </div>
                <div class="text-gray-600 mt-2">Total Skill Level</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded">
                <div class="text-4xl font-bold text-purple-600">
                  {(profile.totalxp ?? 0).toLocaleString()}
                </div>
                <div class="text-gray-600 mt-2">Total XP</div>
              </div>
            </div>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="text-center p-3 bg-gray-50 rounded">
                <div class="text-2xl font-bold">
                  {profile.questscomplete ?? 0}
                </div>
                <div class="text-gray-600 text-sm">Quests Complete</div>
              </div>
              <div class="text-center p-3 bg-gray-50 rounded">
                <div class="text-2xl font-bold">{profile.rank ?? "N/A"}</div>
                <div class="text-gray-600 text-sm">Overall Rank</div>
              </div>
              <div class="text-center p-3 bg-gray-50 rounded">
                <div class="text-2xl font-bold">
                  {profile.loggedIn === "true" ? "Online" : "Offline"}
                </div>
                <div class="text-gray-600 text-sm">Status</div>
              </div>
            </div>
          </div>

          {/* Skills Table */}
          <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
            <h2 class="text-3xl font-bold mb-6">Skills</h2>
            {skills.length > 0 ? (
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr class="border-b-2 border-gray-200">
                      <th class="text-left py-3 px-4">Skill</th>
                      <th class="text-right py-3 px-4">Level</th>
                      <th class="text-right py-3 px-4">XP</th>
                      <th class="text-right py-3 px-4">Rank</th>
                    </tr>
                  </thead>
                  <tbody>
                    {[...skills]
                      .sort((a, b) => (b?.xp || 0) / 10 - (a?.xp || 0) / 10)
                      .map((skill) => (
                        <tr class="border-b border-gray-100 hover:bg-gray-50">
                          <td class="py-3 px-4 font-medium">
                            {SKILL_NAMES[skill?.id] ||
                              `Skill ${skill?.id || "Unknown"}`}
                          </td>
                          <td class="text-right py-3 px-4">
                            {skill?.level || 0}
                          </td>
                          <td class="text-right py-3 px-4">
                            {Math.floor((skill?.xp || 0) / 10).toLocaleString()}
                          </td>
                          <td class="text-right py-3 px-4">
                            {(skill?.rank || 0).toLocaleString()}
                          </td>
                        </tr>
                      ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="text-gray-500 text-center py-4">
                No skill data available
              </p>
            )}
          </div>

          {/* Recent Activities */}
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h2 class="text-3xl font-bold mb-6">Recent Activities</h2>
            {activities.length > 0 ? (
              <div class="space-y-4">
                {activities.map((activity) => (
                  <div class="border-l-4 border-blue-500 pl-4 py-2">
                    <h3 class="font-semibold text-lg">
                      {formatActivityText(activity?.text)}
                    </h3>
                    <p class="text-gray-600 text-sm">
                      {formatActivityText(activity?.details)}
                    </p>
                    {activity?.date && (
                      <time
                        datetime={toISODateTime(activity.date) || undefined}
                        class="text-gray-400 text-xs block"
                      >
                        {activity.date}
                      </time>
                    )}
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-gray-500 text-center py-4">No recent activities</p>
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
