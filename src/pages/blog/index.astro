---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner.astro";
import Divider from "@components/Divider.astro";
import Section from "@components/Section.astro";
import Container from "@components/Container.astro";
import Hero from "@components/Hero.astro";
import BlogCard from "@components/BlogCard.astro";
import banner from "@assets/img/blog-banner.jpg";

const allPosts = await getCollection(
  "blog",
  ({ data }: CollectionEntry<"blog">) => {
    return data.draft !== true;
  }
);

// Sort posts by date, newest first
const sortedPosts = allPosts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const characterName = import.meta.env.PUBLIC_CHARACTER_NAME || "Player";
const heroTitle = `${characterName}'s RuneScape Blog`;

const pageTitle = "Blog";
const pageDescription = "Read the latest RuneScape adventures and guides";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <Banner image={banner} />
  <Container>
    <Hero headline={heroTitle} />
    <Section id="blog">
      <Divider loading="eager" />
      {
        sortedPosts.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-xl text-cream">
              No blog posts yet. Check back soon!
            </p>
          </div>
        ) : (
          <ul class="grid gap-0.75 md:grid-cols-2 bg-black">
            {sortedPosts.map((post: CollectionEntry<"blog">) => (
              <li>
                <BlogCard post={post} />
              </li>
            ))}
          </ul>
        )
      }
    </Section>
  </Container>
</BaseLayout>
