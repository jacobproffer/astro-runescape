---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner.astro";
import Container from "@components/Container.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import Divider from "@components/Divider.astro";
import TagList from "@components/TagList.astro";
import TableOfContents from "@components/TableOfContents.astro";
import ContentBox from "@components/ContentBox.astro";
import banner from "@assets/img/slug-banner.jpg";

const { slug } = Astro.params;

const entry = (await getCollection("blog")).find((post) => post.id === slug);

if (!entry || entry.data.draft === true) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);
---

<BaseLayout
  pageTitle={entry.data.title}
  pageDescription={entry.data.description}
>
  <article>
    <Banner image={banner} />
    <Container>
      <Hero headline={entry.data.title} />

      <Section id="blog-content">
        <Divider loading="eager" />
        <div class="flex flex-col gap-0.75">
          <ContentBox
            background="navy-100"
            class="text-yellow text-lg text-shadow-sm text-shadow-black"
          >
            Posted on <time datetime={entry.data.pubDate.toISOString()}>
              {
                entry.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "America/New_York",
                })
              }
            </time>
            <span>by {entry.data.author}</span>
          </ContentBox>
          <div class="grid lg:grid-cols-[1fr_2fr] gap-0.75">
            <div
              class="lg:sticky lg:top-0.75 lg:self-start flex flex-col gap-0.75"
            >
              <TableOfContents headings={headings} />
              <ContentBox>
                <h2
                  class="text-yellow text-3xl max-md:text-2xl font-cinzel font-bold mb-3 text-shadow-sm text-shadow-black"
                >
                  Tags
                </h2>
                <TagList tags={entry.data.tags} />
              </ContentBox>
            </div>
            <ContentBox>
              <div
                class="max-w-prose text-gray-300 [&_h2]:text-yellow [&_h2]:text-3xl [&_h2]:font-cinzel [&_h2]:uppercase [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-4 [&_h2]:text-shadow-sm [&_h2]:text-shadow-black [&_h3]:text-yellow [&_h3]:font-cinzel [&_h3]:font-bold [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:text-shadow-sm [&_h3]:text-shadow-black [&_p]:mb-4 [&_p]:leading-7 [&_ul]:ml-6 [&_ul]:mb-4 [&_ul]:list-disc [&_ol]:ml-6 [&_ol]:mb-4 [&_ol]:list-decimal [&_li]:mb-2 [&_li]:leading-7 [&_a]:text-yellow [&_a]:underline hover:[&_a]:text-cream [&_strong]:text-yellow [&_strong]:font-bold [&_code]:bg-navy-300 [&_code]:px-2 [&_code]:py-1 [&_code]:rounded [&_code]:text-sm"
              >
                <Content />
              </div>
            </ContentBox>
          </div>
        </div>
      </Section>
    </Container>
  </article>
</BaseLayout>
